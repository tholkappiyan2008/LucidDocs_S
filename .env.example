# ============================================================
# ClearDoc Environment Configuration (.env.example)
# Place this file as `.env` in the project root directory.
# ============================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# 2. JWT Authentication (Express Backend)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# 3. Supabase PostgreSQL Configuration
# Found in: Supabase Project Settings -> API
# Note: SUPABASE_SERVICE_ROLE_KEY must remain strictly on the backend!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# 4. Google Gemini API Key
# Found in: Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

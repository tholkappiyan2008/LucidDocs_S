# ============================================================
# ClearDoc Environment Configuration (.env.example)
# Place this file as `.env` in the project root directory.
# ============================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# 2. JWT Authentication (Express Backend)
JWT_SECRET=your_jwt_secret_min_32_characters_long
JWT_EXPIRES_IN=7d

# 3. Supabase PostgreSQL Configuration
# Found in: Supabase Project Settings -> API
# Note: SUPABASE_SERVICE_ROLE_KEY must remain strictly on the backend!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# 4. Groq Multimodal AI API Key
# Found in: Groq Console (https://console.groq.com)
# Model used: qwen/qwen3.8-27b
GROQ_API_KEY=your_groq_api_key

# 5. Frontend Configuration (Vite & Vercel)
# For Local Development:
VITE_API_URL=http://localhost:5000/api/v1
# For Vercel Production Environment Variables:
# VITE_API_URL=https://<your-render-backend-url>.onrender.com/api/v1

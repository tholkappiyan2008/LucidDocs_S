{
  "name": "cleardoc",
  "version": "1.0.0",
  "description": "ClearDoc — AI-Powered Document Accessibility & Understanding Agent",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=apps/backend run dev",
    "dev:frontend": "npm --workspace=apps/frontend run dev",
